<Project Sdk="Microsoft.NET.Sdk">
  <!-- A plain console test runner: no xUnit/NUnit, so the suite runs on a machine
       with no NuGet access. Run with: dotnet run, from this folder. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>FdDraft.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\FdDraft.Core\FdDraft.Core.csproj" />
  </ItemGroup>
</Project>
