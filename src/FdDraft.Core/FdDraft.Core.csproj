<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The drafting engine: FD-Pro job reader, geometry, labels, sheet/scale picker,
    title-block rules. No CAD library and no package dependencies, so it stays
    unit-testable and every front end (the DWG writer, the app, the CLI) shares it.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>FdDraft.Core</RootNamespace>
    <AssemblyName>FdDraft.Core</AssemblyName>
  </PropertyGroup>
</Project>
