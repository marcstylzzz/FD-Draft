<Project Sdk="Microsoft.NET.Sdk">
  <!-- Command-line front end: FD-Pro job + firm .dwt in, drafted DWG out.
       The same engine the desktop app will use; handy for batches and testing. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>fddraft</AssemblyName>
    <RootNamespace>FdDraft.Cli</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\FdDraft.Core\FdDraft.Core.csproj" />
    <ProjectReference Include="..\..\src\FdDraft.Cad\FdDraft.Cad.csproj" />
  </ItemGroup>
</Project>
