<Project>
  <!--
    Shared settings for every FD-Draft project.

    Needs the .NET 10 SDK: the bundled ACadSharp source uses C# 13 features.
    FD-Draft itself still targets .NET 8 (net8.0 / net8.0-windows).

    FD_OFFLINE=1 is for machines with no NuGet access (the cloud build box):
    no apphost is generated (its pack comes from NuGet) - see build-offline.sh.
  -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Company>Vaughan Land Surveyors</Company>
    <Product>FD-Draft</Product>
    <Version>0.4.18</Version>
    <Deterministic>true</Deterministic>
    <!-- Run on the newest .NET installed (e.g. only the .NET 10 SDK) instead of demanding .NET 8. -->
    <RollForward>Major</RollForward>
  </PropertyGroup>
  <PropertyGroup Condition="'$(FD_OFFLINE)' == '1'">
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>
</Project>
